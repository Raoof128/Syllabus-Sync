# Static assets are served straight from the ASSETS binding and never reach the
# Worker (see `run_worker_first` exclusions in wrangler.jsonc), so the headers
# declared in `config/next/next.config.ts` do not apply to them. Vercel served
# these four on every asset; without this block Cloudflare served none.
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

/icons/*
  Cache-Control: public,max-age=31536000,immutable

/images/*
  Cache-Control: public,max-age=31536000,immutable

# One rule only. `/manifest.webmanifest` used to be declared here AND matched by
# a `/*.webmanifest` glob below it; Cloudflare applies every matching rule and
# appends, so production served
#   content-type: application/manifest+json, application/manifest+json
# which is an invalid single-value header a browser may reject outright. This was
# the "doubled Content-Type, root cause unidentified" follow-up from the
# 2026-07-29 preview deployment. The glob already covers the concrete filename,
# so the exact-path duplicate is what had to go.
/*.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public,max-age=86400
