{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "syllabus-sync-preview",
  "main": "custom-worker.ts",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "keep_vars": true,
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/_next/static/*",
      "!/icons/*",
      "!/images/*",
      "!/favicon.ico",
      "!/manifest.webmanifest",
      "!/*.webmanifest",
      "!/*.woff2",
      "!/sw.js",
    ],
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "syllabus-sync-preview",
    },
  ],
  "images": {
    "binding": "IMAGES",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "vars": {
    "DEPLOYMENT_PLATFORM": "cloudflare",
    "DEPLOYMENT_ENV": "preview",
  },
  "triggers": {
    "crons": [],
  },
  "env": {
    "production": {
      "name": "syllabus-sync-production",
      "workers_dev": false,
      "preview_urls": false,
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "syllabus-sync-production",
        },
      ],
      "images": {
        "binding": "IMAGES",
      },
      "vars": {
        "DEPLOYMENT_PLATFORM": "cloudflare",
        "DEPLOYMENT_ENV": "production",
      },
      "triggers": {
        "crons": [],
      },
    },
  },
}
